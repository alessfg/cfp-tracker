---
import BaseLayout from '../layouts/BaseLayout.astro';
import FilterBar from '../components/FilterBar.astro';
import CFPTable from '../components/CFPTable.astro';
import type { CFP } from '../lib/cfp';

import cfpData from '../../data/cfps.json';

const { lastUpdated } = cfpData;
const cfps = cfpData.cfps as CFP[];
---

<BaseLayout lastUpdated={lastUpdated}>
  <FilterBar cfps={cfps} />
  <CFPTable cfps={cfps} />
</BaseLayout>
